* text=auto eol=lf
/.editorconfig export-ignore
/.git export-ignore
/.gitattributes export-ignore
/.github export-ignore
/.gitignore export-ignore
/.phpstan.cache export-ignore
/CHANGELOG.md export-ignore
/CHARTER.md export-ignore
/build export-ignore
/composer.lock export-ignore
/coverage export-ignore
/dist export-ignore
/docs export-ignore
/examples export-ignore
/phpcs.xml export-ignore
/phpstan.neon export-ignore
/tests export-ignore
/tools export-ignore
/vendor export-ignore

# The pinned Studio release owns only the manifest-bound protocol/, testkit/,
# and browser/ layout. Never resurrect legacy mirror paths in an archive.
/resources/studio-contract/conformance export-ignore
/resources/studio-contract/schemas export-ignore

# Published third-party license bytes are digest-bound and must retain any
# upstream trailing space exactly rather than being normalized during review.
/resources/studio-contract/browser/third-party-licenses/*.txt whitespace=-trailing-space

# These obsolete idempotency seams stay outside package archives.
/src/Wire/IdempotencyRecord.php export-ignore
/src/Wire/Port/IdempotencyLedgerInterface.php export-ignore
