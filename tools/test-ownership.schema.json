{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kumwe.org/schemas/test-ownership/v1",
  "title": "Kumwe package test ownership v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kumwe-test-ownership/v1"
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "api_manifest": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inventory_command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "inventory_command"
      ]
    },
    "exports": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "behavior": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "boundary": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "behavior",
          "boundary"
        ]
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "owned",
            "not-applicable"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "corpora": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "rationale",
        "tests",
        "corpora"
      ]
    },
    "architecture": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "transfers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_test": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "remove-on-adoption",
                  "split-on-adoption",
                  "retain-until-runtime-cutover"
                ]
              },
              "package_tests": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "retained": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_test",
              "action",
              "package_tests",
              "retained"
            ]
          }
        },
        "retained_responsibilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "repository",
        "baseline",
        "transfers",
        "retained_responsibilities"
      ]
    }
  },
  "required": [
    "schema",
    "package",
    "api_manifest",
    "suite",
    "exports",
    "conformance",
    "architecture",
    "host"
  ]
}
