<?xml version="1.0"?>
<ruleset name="Kumwe Producer">
    <description>Kumwe Producer coding standard.</description>
    <file>smoke.php</file>
    <file>src</file>
    <file>tools</file>
    <file>tests</file>
    <file>examples</file>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <rule ref="PSR12"/>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>smoke.php</exclude-pattern>
        <exclude-pattern>tools/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>
</ruleset>
